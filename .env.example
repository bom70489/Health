# No credentials needed for explicitly labeled fictional local demo.
EXPO_PUBLIC_USE_DEMO_MODE=true

# Set demo=false to use real Supabase Auth/RLS. Never use service_role here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional EAS development build and remote reminder registration.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Remote replaces local scheduling only after successful native registration.
EXPO_PUBLIC_ENABLE_REMOTE_PUSH=false
